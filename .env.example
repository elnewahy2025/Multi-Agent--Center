# AI Coding Command Center Environment Configuration
# Copy this file to .env and configure your local settings.

# Persistence Settings
# Primary: Local PostgreSQL 18
COMMAND_CENTER_DATABASE_URL=postgresql+psycopg2://postgres/REDACTED@localhost:5433/command_center

# Fallback: SQLite (Optional for portable runs)
# COMMAND_CENTER_DATABASE_URL=sqlite:///./data/command_center.db

# Orchestrator API
COMMAND_CENTER_PORT=8000
COMMAND_CENTER_HOST=127.0.0.1
COMMAND_CENTER_LOG_LEVEL=INFO

# Security and Autonomy Policies
# Available modes: STRICT, ASK, AUTO_LOW_IMPACT, ALLOW_ALL
COMMAND_CENTER_DEFAULT_POLICY=AUTO_LOW_IMPACT
COMMAND_CENTER_MAX_CONCURRENT_WORKERS=2
